rules_version = '2';

// =============================================================================
// Firestore Security Rules — Warehouse Mobile App v2
// Referensi: docs/firestore-schema.md §4, docs/PRD-v2.md BR-04, BR-09
//
// Prinsip:
//  - Client hanya boleh MEMBUAT transaksi (create-only) dan mengelola cycle-count.
//  - balances, stockCards, auditLogs, sheetExports, stockConflicts = Function only.
//  - Role & kepemilikan ditegakkan di sini, bukan hanya di UI.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers -----------------------------------------------------

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() && exists(userDocPath());
    }

    function profile() {
      return get(userDocPath()).data;
    }

    function role() {
      return userExists() ? profile().role : 'none';
    }

    function isActive() {
      return userExists() && profile().active == true;
    }

    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    function isSupervisor() {
      return isActive() && (role() == 'supervisor' || role() == 'admin');
    }

    function isOperatorOrAbove() {
      return isActive() && (role() == 'operator' || role() == 'supervisor');
    }

    function inWarehouse(wid) {
      return isActive() && wid in profile().warehouseIds;
    }

    function isPeriodKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isNonZeroInt(v) {
      return v is int && v != 0;
    }

    function cycleCountData(id) {
      return get(/databases/$(database)/documents/cycleCounts/$(id)).data;
    }

    // ---------- Users -------------------------------------------------------

    match /users/{uid} {
      // Profil sendiri selalu boleh dibaca (termasuk saat active=false) agar
      // aplikasi bisa menampilkan SCR-02 "akun dinonaktifkan", bukan error izin.
      // Supervisor/admin boleh melihat semua.
      allow read: if signedIn() && (request.auth.uid == uid || isSupervisor());
      allow create, update, delete: if isAdmin();
    }

    // ---------- Warehouses & turunannya -------------------------------------

    match /warehouses/{wid} {
      allow read: if inWarehouse(wid) || isAdmin();
      allow write: if isAdmin();

      // Saldo = hasil hitung Function, bukan tulisan client.
      match /balances/{productId} {
        allow read: if inWarehouse(wid) || isAdmin();
        allow write: if false;
      }

      // Periode & stock card dibuat oleh job closing.
      match /periods/{periodKey} {
        allow read: if inWarehouse(wid) || isAdmin();
        allow write: if false;

        match /stockCards/{productId} {
          allow read: if inWarehouse(wid) || isAdmin();
          allow write: if false;
        }
      }
    }

    // ---------- Master produk ----------------------------------------------

    match /products/{productId} {
      allow read: if isActive();
      // Import/ubah produk lewat Function (Admin SDK) atau admin.
      allow write: if isAdmin();
    }

    match /barcodes/{barcode} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Kunci impor produk (VS1-06). Hanya Cloud Function (Admin SDK) yang
    // boleh menyentuhnya; klien tidak perlu membaca atau menulis.
    match /importLocks/{warehouseId} {
      allow read, write: if false;
    }

    // ---------- Devices -----------------------------------------------------

    match /devices/{deviceId} {
      allow read: if isActive() && (resource.data.userId == request.auth.uid || isSupervisor());
      allow create, update: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ---------- Transactions (ledger immutable) ----------------------------

    match /transactions/{transactionId} {
      // CREATE-ONLY = idempotency (BR-04). Request ulang dengan ID sama ditolak.
      allow create: if isOperatorOrAbove()
        && request.resource.data.userId == request.auth.uid
        && inWarehouse(request.resource.data.warehouseId)
        && request.resource.data.keys().hasAll([
             'schemaVersion', 'warehouseId', 'productId', 'productCode',
             'productName', 'productType', 'uom', 'type', 'qty', 'signedQty',
             'periodKey', 'userId', 'userName', 'deviceId', 'occurredAt',
             'createdAtClient', 'appVersion', 'source'
           ])
        // Client tidak boleh memalsukan metadata server.
        && !request.resource.data.keys().hasAny([
             'serverStatus', 'createdAtServer', 'syncedAt'
           ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.type in ['incoming', 'outgoing', 'adjustment', 'reversal']
        && isNonZeroInt(request.resource.data.qty)
        && isNonZeroInt(request.resource.data.signedQty)
        // Tanda harus konsisten dengan jenis transaksi (samakan dengan CHECK di SQLite)
        && (
             (request.resource.data.type == 'incoming'
                && request.resource.data.qty > 0
                && request.resource.data.signedQty == request.resource.data.qty)
          || (request.resource.data.type == 'outgoing'
                && request.resource.data.qty > 0
                && request.resource.data.signedQty == -request.resource.data.qty)
          || (request.resource.data.type in ['adjustment', 'reversal']
                && request.resource.data.signedQty == request.resource.data.qty)
           )
        && (request.resource.data.type != 'reversal'
              || request.resource.data.keys().hasAll(['refTransactionId']))
        && (request.resource.data.type != 'adjustment'
              || request.resource.data.keys().hasAll(['cycleCountId']))
        && isPeriodKey(request.resource.data.periodKey)
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.createdAtClient is timestamp
        && request.resource.data.productName.size() <= 200
        && request.resource.data.uom.size() <= 20
        && request.resource.data.source in ['scan', 'manual', 'cycle_count', 'server']
        // Override stok negatif hanya boleh berstatus pending, tidak langsung approved.
        && (!request.resource.data.keys().hasAny(['approval'])
            || request.resource.data.approval.status == 'pending');

      // Ledger tidak boleh diubah/dihapus dari client (BR-06).
      allow update, delete: if false;

      allow read: if isSupervisor()
        || (isActive() && resource.data.userId == request.auth.uid);
    }

    // ---------- Cycle count -------------------------------------------------

    match /cycleCounts/{cycleCountId} {
      allow read: if isActive() && (
        inWarehouse(resource.data.warehouseId) || isSupervisor()
      );

      allow create: if isActive()
        && inWarehouse(request.resource.data.warehouseId)
        && request.resource.data.keys().hasAll([
             'warehouseId', 'periodKey', 'status', 'startedBy', 'startedAt'
           ])
        && request.resource.data.status == 'open'
        && request.resource.data.startedBy == request.auth.uid
        && isPeriodKey(request.resource.data.periodKey);

      // Operator hanya boleh: mengubah sesi yang masih open, dan submit (open -> submitted).
      // Approval (submitted -> approved/rejected) dilakukan Function oleh supervisor.
      // Total variance & daftar adjustment dihitung ulang di server, bukan dipercaya dari client.
      allow update: if isActive()
        && inWarehouse(resource.data.warehouseId)
        && resource.data.status == 'open'
        && !request.resource.data.keys().hasAny(['adjustmentTxnIds'])
        && request.resource.data.status in ['open', 'submitted']
        && request.resource.data.warehouseId == resource.data.warehouseId
        && request.resource.data.periodKey == resource.data.periodKey
        && request.resource.data.startedBy == resource.data.startedBy
        && request.resource.data.startedAt == resource.data.startedAt;

      allow delete: if false;

      match /countLines/{productId} {
        allow read: if isActive()
          && (inWarehouse(cycleCountData(cycleCountId).warehouseId) || isAdmin());

        allow create, update: if isActive()
          && inWarehouse(cycleCountData(cycleCountId).warehouseId)
          && cycleCountData(cycleCountId).status == 'open'
          && request.resource.data.productId == productId
          && request.resource.data.systemQty is int
          && request.resource.data.countedQty is int
          && request.resource.data.countedQty >= 0
          && request.resource.data.countedBy == request.auth.uid
          // Kolom hasil approval hanya boleh diisi Function.
          && (!request.resource.data.keys().hasAny(['adjustmentTxnId'])
              || request.resource.data.adjustmentTxnId == null)
          && (!request.resource.data.keys().hasAny(['approvalStatus'])
              || request.resource.data.approvalStatus == 'none')
          && request.resource.data.variance ==
             (request.resource.data.countedQty - request.resource.data.systemQty);

        allow delete: if isActive()
          && inWarehouse(cycleCountData(cycleCountId).warehouseId)
          && cycleCountData(cycleCountId).status == 'open';
      }
    }

    // ---------- Hasil sistem (read-only untuk manusia) ---------------------

    match /stockConflicts/{conflictId} {
      allow read: if isSupervisor();
      // Deteksi dan penulisan awal hanya Function. Supervisor hanya boleh
      // menutup konflik yang masih open, dengan alasan ≥10 karakter (BR-12).
      allow create, delete: if false;
      allow update: if isSupervisor()
        && resource.data.status == 'open'
        && request.resource.data.status in ['resolved', 'ignored']
        && request.resource.data.resolution in
            ['accept_server', 'adjust_to_device', 'ignore']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt is int
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
    }

    match /auditLogs/{logId} {
      allow read: if isSupervisor();
      allow write: if false;
    }

    match /sheetExports/{exportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Konfigurasi aplikasi ---------------------------------------

    match /appConfig/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- Default deny ------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
